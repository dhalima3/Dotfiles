{
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "breadcrumbs.enabled": true,
  "cSpell.userWords": [
    "UUID",
    "curr",
    "mutex",
    "ppid",
    "repo",
    "xrange",
    "zillow"
  ],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  // "editor.fontFamily": "Menlo, Monaco, 'Courier New', monospace",
  "editor.fontFamily": "Fira Code",
  "editor.fontLigatures": "'ss02', 'ss03', 'ss05'",
  "editor.lineNumbers": "on",
  "editor.minimap.enabled": false,
  "editor.rulers": [
    120
  ],
  "editor.semanticTokenColorCustomizations": {
    "enabled": true, // enable for all themes
    "[Cobalt2]": {
      "enabled": true,
      "rules": {
        // "type":  "#ff628c",
        // "namespace": "#00897B",
        // "function": "#00BCD4",
        // "variable": "#42A5F5",
        // "number": "#90A4AE",
        // "string": {
        //     "foreground": "#90A4AE",
        //     "italic": true
        // },
        // "comment": {
        //     "foreground": "#546E7A",
        //     "fontStyle": "italic"
        // },
        "variable.readonly.defaultLibrary": "#ff628c",
        // "macro": "#7E57C2",
        // "keyword": "#7986CB",
        // "operator": "#9575CD",
        // "type.modification": "#00897B",
        // "punctuation": "#A1887F"
      }
    }
  },
  "editor.snippetSuggestions": "top",
  "editor.suggestSelection": "first",
  // "files.autoSave": "afterDelay",
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "git.autoStash": true,
  "git.autofetch": true,
  "git.confirmSync": true,
  "gitlens.blame.format": "${author|7?} ${message|20?} ${agoOrDate|14-}",
  "gitlens.blame.highlight.locations": [
    "overview",
    "gutter",
    "line"
  ],
  "gitlens.codeLens.enabled": false,
  "gitlens.currentLine.enabled": false,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.menus": {
    "editor": {
      "blame": false,
      "clipboard": true,
      "compare": true,
      "details": true,
      "history": true,
      "remote": true
    },
    "editorGroup": {
      "blame": true,
      "compare": true,
      "history": false,
      "remote": false
    },
    "editorTab": {
      "compare": false,
      "history": false,
      "remote": true
    },
    "explorer": {
      "compare": true,
      "history": true,
      "remote": true
    }
  },
  "gitlens.views.repositories.files.layout": "tree",
  "[go]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    }
  },
  //   "javascript.implicitProjectConfig.checkJs": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "python.languageServer": "None",
  "ruff.lineLength": 120,
  "ty.importStrategy": "useBundled",
  "search.exclude": {
    "**/node_modules": true,
    "**/.history": true,
    "**/.idea": true,
    "**/vendor": true
  },
  "search.showLineNumbers": false,
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.external.osxExec": "iTerm.app",
  "terminal.integrated.fontFamily": "MesloLGS NF",
  "terminal.integrated.fontSize": 14,
  "vim.leader": "<space>",
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<leader>",
        "i"
      ],
      "commands": [
        "editor.action.goToDeclaration"
      ]
    },
    {
      "before": [
        "<leader>",
        "u"
      ],
      "commands": [
        "references-view.find",
      ],
      "when": "editorHasReferenceProvider"
    },
    {
      "before": [
        "<leader>",
        "b"
      ],
      "commands": [
        "editor.debug.action.toggleBreakpoint"
      ]
    },
    {
      "before": [
        "<leader>",
        "d"
      ],
      "commands": [
        "workbench.action.debug.start"
      ]
    },
    {
      "before": [
        "<leader>",
        "r"
      ],
      "commands": [
        "python.execInTerminal"
      ],
      "when": "editorFocus && editorLangId == 'python'"
    },
    // {
    //   "before": [
    //     "<leader>",
    //     "r"
    //   ],
    //   "commands": [
    //     "code-runner.run"
    //   ],
    //   "when": "editorFocus && editorLangId == 'javascript'"
    // },
  ],
  "vim.useSystemClipboard": true,
  "zenMode.centerLayout": false,
  "zenMode.fullScreen": false,
  "zenMode.hideLineNumbers": false,
  "zenMode.hideStatusBar": false,
  "zenMode.restore": false,
  "zenMode.showTabs": "single",
  "zenMode.silentNotifications": false,
  "window.openFoldersInNewWindow": "on",
  "window.title": "${activeEditorLong},${separator}${rootName}",
  "workbench.activityBar.location": "hidden",
  "workbench.colorCustomizations": {
    "terminal.foreground": "#839496",
    "terminal.background": "#193549",
    "focusBorder": "#ffc600",
  },
  "workbench.colorTheme": "Cobalt2",
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "workbench.editor.enablePreview": true,
  "workbench.editor.showTabs": "single",
  "workbench.list.openMode": "doubleClick",
  "workbench.localHistory.mergeWindow": 300,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "explorer.openEditors.visible": 1,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "editor.cursorSurroundingLines": 5,
  "search.useGlobalIgnoreFiles": true,
  "todo-tree.highlights.customHighlight": {
    "TODO": {},
    "FIXME": {}
  },
  "todo-tree.highlights.defaultHighlight": {
    "foreground": "green",
    "type": "none"
  },
  // "leetcode.workspaceFolder": "/Users/darylh/Github/PracticeProblems/Leetcode",
  "leetcode.workspaceFolder": "/Users/darylh/Github/PracticeScratch",
  "leetcode.hint.configWebviewMarkdown": false,
  "leetcode.hint.commandShortcut": false,
  "leetcode.showCommentDescription": true,
  "leetcode.defaultLanguage": "python3",
  "leetcode.hint.commentDescription": false,
  "editor.columnSelection": false,
  "editor.fontSize": 15,
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook"
  },
  "editor.cursorStyle": "line",
  "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
  "editor.wordWrap": "off",
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "left"
  },
  "leetcode.filePath": {
    "default": {
      "folder": "",
      "filename": "${id}.${kebab-case-name}.${ext}"
    }
  },
  "cSpell.language": "en,en-US",
  "vsicons.dontShowNewVersionMessage": true,
  "go.toolsManagement.autoUpdate": true,
  "files.exclude": {
    "**/__pycache__": true
  },
}
